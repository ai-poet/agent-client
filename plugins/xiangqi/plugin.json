{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "xiangqi",
  "version": "0.1.4",
  "description": "Play Chinese chess against an AI opponent",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "min_sailry_version": "0.1.6",
      "description": {
        "label": "Play Chinese chess against an AI opponent",
        "locales": {
          "zh-CN": "与 AI 对手下中国象棋"
        }
      },
      "scope": "desktop",
      "actions": [
        "models.generate"
      ],
      "desktop": {
        "entry": "dev.sailry.platform/desktop/main.js",
        "navigation": {
          "label": "Chinese chess",
          "locales": {
            "zh-CN": "中国象棋"
          },
          "icon": "reicon:ui/crown"
        },
        "resources": [
          "dev.sailry.platform/desktop/main.js",
          "dev.sailry.platform/desktop/game.js",
          "dev.sailry.platform/desktop/model.js",
          "dev.sailry.platform/desktop/view.js",
          "dev.sailry.platform/desktop/board.js",
          "dev.sailry.platform/desktop/motion.js",
          "dev.sailry.platform/desktop/locales.js",
          "dev.sailry.platform/desktop/board.svg",
          "dev.sailry.platform/desktop/controls.js",
          "dev.sailry.platform/desktop/layout.js",
          "dev.sailry.platform/desktop/history.js",
          "dev.sailry.platform/desktop/assets/town-pattern.png",
          "dev.sailry.platform/desktop/assets/character-01.png",
          "dev.sailry.platform/desktop/assets/character-02.png"
        ]
      },
      "settings_schema": "dev.sailry.platform/settings.json",
      "display": {
        "label": "Chinese chess",
        "locales": {
          "zh-CN": "中国象棋"
        },
        "icon": "phosphor:horse"
      },
      "category": "entertainment",
      "tint": "teal"
    }
  }
}
