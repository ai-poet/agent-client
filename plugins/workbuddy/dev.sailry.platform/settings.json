{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkin_enabled",
    "checkin_time"
  ],
  "properties": {
    "free_only_china": {
      "type": "boolean",
      "title": "Free models only (China)",
      "default": true
    },
    "free_only_international": {
      "type": "boolean",
      "title": "Free models only (WorkBuddy International)",
      "default": true
    },
    "free_only_codebuddy": {
      "type": "boolean",
      "title": "Free models only (CodeBuddy International)",
      "default": true
    },
    "checkin_enabled": {
      "type": "boolean",
      "title": "Automatic check-in",
      "default": false
    },
    "checkin_time": {
      "type": "string",
      "title": "Check-in time (Asia/Shanghai)",
      "default": "09:05",
      "minLength": 5,
      "maxLength": 5,
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
      "x-sailry-time": true
    }
  },
  "x-sailry-locales": {
    "en": {
      "checkin_time": "Daily check-in time (Asia/Shanghai)",
      "checkin_enabled": "Automatic check-in",
      "free_only_china": "Free models only (China)",
